# LLM — OpenAI (required)
OPENAI_API_KEY=sk-...

# HuggingFace — used for embeddings via Inference API (sentence-transformers/all-MiniLM-L6-v2)
# Free tier works without a token but is rate-limited. Get one at huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Voice pipeline — LiveKit Cloud (required)
# Free tier: 5,000 WebRTC min/mo — https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voice pipeline — Deepgram STT (required)
# Free tier: 12,000 min/mo — https://deepgram.com
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TTS — Cartesia (required for voice output)
# https://cartesia.ai — get an API key from the dashboard
CARTESIA_API_KEY=sk_car_...
CARTESIA_VOICE_ID=f039066f-cdb7-45ed-b51d-1034ae2f04a0
CARTESIA_MODEL=sonic-2

# Database + storage
DATABASE_URL=postgresql+asyncpg://wavvy:wavvy@localhost:5433/wavvy
CHROMA_PERSIST_DIR=./chroma_db

# Frontend URLs (for CORS allowlist)
# Local dev — Vite default ports:
FRONTEND_LANDING_URL=http://localhost:5173
FRONTEND_AGENT_URL=http://localhost:5174
FRONTEND_ADMIN_URL=http://localhost:5175
# Production (HuggingFace Spaces backend) — set these to your Vercel deployment URLs:
# FRONTEND_LANDING_URL=https://your-landing.vercel.app
# FRONTEND_AGENT_URL=https://your-agent.vercel.app
# FRONTEND_ADMIN_URL=https://your-admin.vercel.app

# Backend public URL (used for SIP webhook target)
# Local dev:
PUBLIC_BACKEND_URL=http://localhost:8000
# Production:
# PUBLIC_BACKEND_URL=https://your-space.hf.space

ENVIRONMENT=development
# Set to "production" on HuggingFace — enables strict CORS (specific origins only)
# ENVIRONMENT=production

SECRET_KEY=change-in-production
